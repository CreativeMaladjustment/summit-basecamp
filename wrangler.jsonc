{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Renamed from summit-hearth-api for the Summit Basecamp rebrand. Cloudflare
  // Workers can't be renamed in place -- this "name" is what wrangler deploy
  // creates/targets, so changing it deploys a *new* Worker at a new
  // *.workers.dev hostname rather than relabeling the old one. The old
  // summit-hearth-api Worker keeps existing (and keeps serving whatever it
  // last deployed) until .github/workflows/decommission-cloudflare.yml is
  // run against it by hand, after CF_API_BASE_URL (the GitHub variable
  // .github/workflows/sync-roster.yml reads) has been updated to this new
  // hostname -- deleting the old one first, or before that variable is
  // updated, breaks the next scheduled sync silently.
  "name": "summit-basecamp-api",
  "main": "src/entry.py",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["python_workers"],

  // Non-secret config only. Secrets (SESSION_HMAC_SECRET, GOOGLE_CLIENT_ID,
  // APPLE_CLIENT_ID) are set with `wrangler secret put <NAME>` and are
  // never committed here. SYNC_ADMIN_TOKEN is the exception: it's pushed
  // here by deploy.yml's "Set SYNC_ADMIN_TOKEN secret" step, from the
  // CF_SYNC_ADMIN_TOKEN secret on the GitHub repo -- set that one GitHub
  // secret and every deploy keeps this in sync, no local wrangler needed.
  // It authenticates POST /api/admin/sync (see src/handlers.trigger_sync);
  // .github/workflows/sync-roster.yml sends it as a bearer token.
  "vars": {
    "ENVIRONMENT": "production"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "summit-hearth-db",
      "database_id": "36756ced-9cfe-4c82-86b0-8585dc774c91",
      "migrations_dir": "migrations"
    }
  ],

  // Player headshots and crests are still committed to
  // frontend/public/assets/images/ and served by Pages -- player_bios.image_path
  // holds the root-relative path to each one, and this app has no general
  // object storage for that. AVATARS below is the one exception: member
  // profile pictures are user-uploaded at runtime, so they can't be
  // committed to the repo the way the roster/bio images are. Backed by KV,
  // not R2: R2 needs its own one-time account-level enablement in the
  // Cloudflare dashboard before any API token can touch it, where KV is
  // already active on this account (SESSIONS below already uses it) --
  // and a 2 MiB profile picture is well inside KV's 25 MiB per-value limit.
  // Provisioned the same way as SESSIONS and DB: run "Provision Cloudflare
  // resources" (.github/workflows/provision-cloudflare.yml) once, which
  // replaces the 95d79e2f781242019deb01157a29cb1b placeholder below via
  // a PR -- no `wrangler kv namespace create` run by hand.
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "ebf7b5e64fd544408b75d882492b2552"
    },
    {
      "binding": "AVATARS",
      "id": "95d79e2f781242019deb01157a29cb1b"
    }
  ],

  // Two daily jobs only -- the weekly roster/fixture/headshot sync used to
  // be a third cron here, but now runs via POST /api/admin/sync, triggered
  // by .github/workflows/sync-roster.yml instead (see src/entry.py).
  "triggers": {
    "crons": [
      "0 8 * * *",
      "0 10 * * *"
    ]
  },

  "observability": {
    "enabled": true
  },

  "env": {
    "development": {
      "vars": {
        "ENVIRONMENT": "development"
      }
    }
  }
}
